cabal-version:      3.0
name:               eeep
version:            0.0.1.0
synopsis:           A Haskell library for modding Infinity Engine games.
description:        Please see the README on GitHub at <https://github.com/lambda-dom/eeep#readme>
category:           Data
homepage:           https://github.com/lambda-dom/eeep#readme
author:             lambda-dom
license:            BSD-3-Clause
license-file:       LICENSE
maintainer:         grodrigues.math@gmail.com
copyright:          2026 G. Rodrigues
build-type:         Simple
tested-with:
extra-doc-files:
    LICENSE
    README.md
    CHANGELOG.md

source-repository head
    type: git
    location: https://github.com/lambda-dom/eeep

library
    default-language: GHC2021
    default-extensions:
        DerivingStrategies
        DuplicateRecordFields
        OverloadedLabels
        LambdaCase
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-export-lists
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints
        -Wmissing-deriving-strategies
        -Wunused-packages
        -- Prepare for dependent types.
        -Wterm-variable-capture
    hs-source-dirs:
        src
    build-depends:
        -- GHC >= 9.10 && < 9.12
        base               >=4.20  && <4.21,
        -- Libraries.
        bytestring         >=0.12  && <0.13,
        contravariant      >=1.5   && <1.6,
        file-io            >=0.2   && <0.3,
        filepath           >=1.5   && <1.6,
        mtl                >=2.3   && <2.4,
        optics-core        >=0.4.2 && <0.4.3,
        vector             >=0.13  && <0.14,
        -- Non-hackage libraries.
        mono               >=0.1   && <0.2,
        optics-conversions >=0.0.1 && <0.1,
        trisagion          >=0.0.1 && <0.1,
    other-modules:
    exposed-modules:
        Eeep.Types.Shared.Attribute
        Eeep.Types.Shared.Block
        Eeep.Types.Shared.Dice
        Eeep.Types.Shared.Percentage
        Eeep.Types.Shared.Proficiency
        Eeep.Types.Shared.Projectile
        Eeep.Types.Shared.Resref
        Eeep.Types.Shared.School
        Eeep.Types.Shared.Sectype
        Eeep.Types.Shared.Strength
        Eeep.Types.Shared.Strref
        Eeep.Types.Shared.Ability.Location
        Eeep.Types.Shared.Ability.Range
        Eeep.Types.Shared.Ability.Speed
        Eeep.Types.Shared.Ability.Target
        Eeep.Types.Opcode.OpType
        Eeep.Types.Opcode.Target
        Eeep.Types.Opcode.Parameter
        Eeep.Types.Opcode.Power
        Eeep.Types.Opcode.Duration
        Eeep.Types.Opcode.Timing
        Eeep.Types.Opcode.Probability
        Eeep.Types.Opcode.ResistDispel
        Eeep.Types.Opcode.Flags
        Eeep.Types.Opcode.SaveBonus
        Eeep.Types.Opcode.Special
        Eeep.Types.Opcode
        Eeep.Types.Effect
        Eeep.Types.Spell.Ability.Level
        Eeep.Types.Spell.Ability.Header
        Eeep.Types.Spell.SpType
        Eeep.Types.Spell.Level
        Eeep.Types.Spell.Flags
        Eeep.Types.Spell.Exclusion
        Eeep.Types.Spell.Graphics
        Eeep.Types.Spell.Ability
        Eeep.Types.Spell.Header
        Eeep.Types.Spell
        Eeep.Types.Item.Ability.Attack
        Eeep.Types.Item.Ability.Charge
        Eeep.Types.Item.Ability.Damage
        Eeep.Types.Item.Ability.Flags
        Eeep.Types.Item.Ability.Launcher
        Eeep.Types.Item.Ability.Melee
        Eeep.Types.Item.Ability.Header
        Eeep.Types.Item.Category
        Eeep.Types.Item.Flags
        Eeep.Types.Item.Usability
        Eeep.Types.Item.KitUsability
        Eeep.Types.Item.Animation
        Eeep.Types.Item.Header
        Eeep.IO
